# External broker API
EXTERNAL_API_BASE_URL=https://uat.xfltrade.com:20121
APP_TYPE=1

# Auto-auth service account
AUTO_AUTH_USERNAME=xxx
AUTO_AUTH_PASSWORD=xxx
AUTO_AUTH_DEVICE_ID=fixed-device-uuid-for-service-account

# Scheduler
SCHEDULED_TIME=06:00
APP_TIMEZONE=Asia/Dhaka

# Pipeline data params
DEFAULT_STOCK_EXCHANGE=DSE
TOKEN_REFRESH_SKEW_MINUTES=5

# Runtime token cache placeholders (source of truth = MySQL token_store; not written to file)
JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=broker_dashboard
DB_PASSWORD=xxx
DB_NAME=broker_dashboard

# FastAPI server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173
