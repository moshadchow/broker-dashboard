# Environment (uat | production) - informational only
APP_ENV=uat

# OMS API endpoints (base URLs + service-account credentials) are managed
# entirely in the database via the admin panel (API Endpoints,
# /admin/oms-endpoints), not via env vars. After a fresh install, log in as
# the seeded default admin and create your primary/secondary/puji/market
# endpoint rows there. See CLAUDE.md "Multi-endpoint OMS routing".

# Symmetric encryption key for oms_endpoints.encrypted_password (Fernet).
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required once any OMS endpoint exists in the DB (admin panel: API Endpoints).
APP_ENCRYPTION_KEY=

# Scheduler
SCHEDULED_TIME=06:00
APP_TIMEZONE=Asia/Dhaka

# Pipeline data params
DEFAULT_STOCK_EXCHANGE=DSE
TOKEN_REFRESH_SKEW_MINUTES=5

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=broker_db
DB_PASSWORD=xxx
DB_NAME=broker_db

# FastAPI server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173

# Admin panel auth (JWT)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
