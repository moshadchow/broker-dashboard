# Environment (uat | production) - informational, drives credential defaults
APP_ENV=production

# External broker API base URL (per-environment, shared by both APIs)
# UAT:        https://uat.xfltrade.com:20121
# Production: https://prod-oms-api-1.xfltrade.com:20121
EXTERNAL_API_BASE_URL=https://prod-oms-api-1.xfltrade.com:20121
APP_TYPE=1

# Auto-auth service account - used for fetch_broker_summary (and as the
# fetch_market_trade_info fallback when MARKET_AUTH_* below are not set)
AUTO_AUTH_USERNAME=xfl_broker_trade_api
AUTO_AUTH_PASSWORD=Bsanjana#0521#
AUTO_AUTH_DEVICE_ID=variable-device-uuid-for-service-account

# Optional dedicated credential set for fetch_market_trade_info.
# Leave blank in UAT to share the AUTO_AUTH_* credentials above.
# In production, fill these in with the dedicated market-data service account.
MARKET_AUTH_USERNAME=xfl_support_moshad
MARKET_AUTH_PASSWORD=Bsanjana#0521#
MARKET_AUTH_DEVICE_ID=variable-device-uuid-for-service-account-1
MARKET_APP_TYPE=1

# Scheduler
SCHEDULED_TIME=03:00
APP_TIMEZONE=Asia/Dhaka

# Pipeline data params
DEFAULT_STOCK_EXCHANGE=DSE
TOKEN_REFRESH_SKEW_MINUTES=5

# Runtime token cache placeholders (source of truth = MySQL token_store; not written to file)
JWT_ACCESS_TOKEN=
JWT_REFRESH_TOKEN=

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=broker_db

# FastAPI server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:5173

# Admin panel auth (JWT)
JWT_SECRET_KEY=NmsnuNpb2ZuTQc1_Mn4UNQpA63YbKIo9ZzYY4footYjoy5q2OTe-_-kTD0fhj5Ai
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
